{
  "name": "first-leaf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "First Leaf: a made-up investing app for first-time investors. Protogen case studies P301, P302, P303. Everything is fictional; not financial advice.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "data:generate": "node scripts/generate-data.mjs",
    "copy:review": "node scripts/copy-review.mjs",
    "validate": "node scripts/validate-data.mjs",
    "validate:selftest": "node scripts/validator-selftest.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:boundaries:selftest": "node scripts/check-boundaries.mjs --selftest",
    "check:deploy": "node scripts/check-deploy.mjs",
    "test:e2e": "playwright test",
    "check:live": "node scripts/check-live.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:icons:selftest": "node scripts/check-icons.mjs --selftest",
    "check": "npm run build && npm run check:fixtures && npm run validate && npm run validate:selftest && npm run check:boundaries && npm run check:boundaries:selftest && npm run check:icons && npm run check:icons:selftest && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.5.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "vuetify": "^3.13.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "firstLeaf": {
    "productionUrl": "https://first-leaf.vercel.app"
  }
}
